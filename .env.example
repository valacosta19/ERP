VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The Gemini API key is NOT a client variable. It lives as a secret of the
# `ask-gemini` Edge Function. Configure it once per Supabase project:
#   supabase secrets set GEMINI_API_KEY=your-gemini-key
#   supabase functions deploy ask-gemini

# ARCA and Mercado Pago credentials MUST NOT be added here with real values.
# They are server-only Supabase Edge Function secrets; see docs/integrations.md.
#
# ARCA homologation (preferred names):
#   ARCA_HOMOLOGATION_CUIT
#   ARCA_HOMOLOGATION_CERT_PEM
#   ARCA_HOMOLOGATION_PRIVATE_KEY_PEM
# Legacy ARCA_CUIT / ARCA_CERT_PEM / ARCA_PRIVATE_KEY_PEM remain a
# homologation-only fallback.
#
# ARCA production (no homologation fallback):
#   ARCA_PRODUCTION_CUIT
#   ARCA_PRODUCTION_CERT_PEM
#   ARCA_PRODUCTION_PRIVATE_KEY_PEM
#   ARCA_PRODUCTION_ENABLED=true  # set only after the production bundle is verified
